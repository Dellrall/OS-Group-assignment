# VHS Tape - Task 6: Sort Equipment Demo
# Equipment Management System by Lye Wei Lun, Lim Yung Juin, Swetha

Output demo/task6_sort_equipment/task6_sort_equipment.gif
Output demo/task6_sort_equipment/task6_sort_equipment.mp4

Require echo

Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 800
Set Theme "Dracula"

# Start the demo
Type "clear"
Enter
Sleep 1s

Type "# Task 6: Sort Equipment Demo"
Enter
Type "# Showcasing Monogatari character-themed sorting"
Enter
Sleep 2s

Type "clear"
Enter
Sleep 500ms

# Start the program
Type "./tenna.sh"
Enter
Sleep 3s

# Sort by Model (Senjougahara theme)
Type "M"
Sleep 3s

# Export option
Type "y"
Sleep 2s
Enter
Sleep 1s

# Back to main menu
Sleep 3s

# Sort by Status (Mayoi theme)  
Type "T"
Sleep 2s

Type "Available"
Enter
Sleep 3s

# Export option
Type "y"
Sleep 2s
Enter
Sleep 1s

# Try Unavailable status
Sleep 2s
Type "T"
Sleep 2s

Type "Unavailable"
Enter
Sleep 3s

# Skip export
Type "q"
Sleep 2s

# Sort by Type (Shinobu theme)
Type "P"
Sleep 2s

Type "keyboard"
Enter
Sleep 3s

# Export option
Type "y"
Sleep 2s
Enter
Sleep 1s

# Try another type
Sleep 2s
Type "P"
Sleep 2s

Type "mouse"
Enter
Sleep 3s

# Skip export
Type "q"
Sleep 2s

# Exit program
Type "Q"
Sleep 2s
# Skip undertale screen
Type " "
Sleep 1s

Type "clear"
Enter
Type "# All sorting functions demonstrated!"
Type "# Character themes: Senjougahara (Purple), Mayoi (Green), Shinobu (Golden)"
Sleep 3s
